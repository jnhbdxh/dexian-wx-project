# WECHAT_PAY_APP_ID=wx...
# WECHAT_PAY_MERCHANT_ID=...
# WECHAT_PAY_MERCHANT_CERT_SERIAL=...
# WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=D:/secrets/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_...
# WECHAT_PAY_PUBLIC_KEY_PATH=D:/secrets/wechatpay_public_key.pem
# WECHAT_PAY_API_V3_KEY=exactly-32-characters-long-key
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
