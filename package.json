{
  "name": "dexian-wx-project",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @dexian/api dev",
    "dev:admin": "pnpm --filter @dexian/admin dev",
    "dev:worker": "pnpm --filter @dexian/api dev:worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @dexian/api db:generate",
    "db:migrate": "pnpm --filter @dexian/api db:migrate"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
