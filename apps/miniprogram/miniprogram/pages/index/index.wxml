<view class="page-shell">
  <view class="hero">
    <view class="brand-row">
      <view class="brand-lockup">
        <text class="brand-name">得闲</text>
        <text class="brand-en">DEXIAN SPA</text>
      </view>
      <button class="receptions-link" bindtap="openReceptions">我的预约</button>
    </view>

    <view class="hero-copy">
      <text class="hero-title">今天，给身体\n留一段空白</text>
      <text class="hero-description">选好项目、时间和服务人员，再核对本次预约信息。</text>
    </view>

    <view class="store-panel">
      <view>
        <text class="store-label">当前门店</text>
        <text class="store-name">{{storeName}}</text>
      </view>
      <view class="earliest-slot">
        <text class="earliest-label">最快可约</text>
        <text class="earliest-time">{{earliestTime}}</text>
      </view>
    </view>
  </view>

  <view class="booking-content">
    <view class="section-heading compact-heading">
      <view>
        <text class="section-title">这次几位到店</text>
        <text class="section-note">多人同行预约即将开放</text>
      </view>
    </view>
    <view class="guest-selector" aria-label="预约人数">
      <button
        wx:for="{{guestCounts}}"
        wx:key="count"
        class="guest-option {{guestCount === item.count ? 'is-active' : ''}} {{!item.enabled ? 'is-disabled' : ''}}"
        disabled="{{!item.enabled}}"
        data-count="{{item.count}}"
        aria-label="{{item.count}} 位{{guestCount === item.count ? '，已选择' : item.enabled ? '' : '，暂未开放'}}"
        aria-checked="{{guestCount === item.count}}"
        aria-disabled="{{!item.enabled || interactionLocked}}"
        bindtap="selectGuestCount"
      >
        {{item.count}} 位
      </button>
    </view>

    <view class="section-heading">
      <view>
        <text class="section-title">从一项舒服的服务开始</text>
        <text class="section-note">当前价格按每位顾客计算</text>
      </view>
      <text class="section-step">项目</text>
    </view>
    <view class="service-list">
      <button
        wx:for="{{services}}"
        wx:key="id"
        class="service-card {{selectedService.id === item.id ? 'is-selected' : ''}}"
        data-id="{{item.id}}"
        aria-label="{{item.name}}，{{item.priceLabel}}，{{item.durationMinutes}} 分钟{{selectedService.id === item.id ? '，已选择' : ''}}"
        aria-checked="{{selectedService.id === item.id}}"
        aria-disabled="{{interactionLocked}}"
        bindtap="selectService"
      >
        <view class="service-mark tone-{{item.tone}}">{{item.mark}}</view>
        <view class="service-copy">
          <view class="service-topline">
            <text class="service-name">{{item.name}}</text>
            <text class="service-price">{{item.priceLabel}}</text>
          </view>
          <text class="service-description">{{item.description}}</text>
          <view class="service-meta">
            <text>{{item.durationMinutes}} 分钟</text>
            <text wx:if="{{selectedService.id === item.id}}" class="selected-label">已选择</text>
          </view>
        </view>
      </button>
    </view>

    <view class="section-heading">
      <view>
        <text class="section-title">选择到店日期</text>
        <text class="section-note">可左右滑动查看更多日期</text>
      </view>
      <text class="section-step">时间</text>
    </view>
    <view wx:if="{{bookingEntryClosed}}" class="availability-error" aria-live="polite">
      <text>门店暂未开放在线预约</text>
      <text>可先查看“我的预约”；门店发布营业政策后，日期和时刻会自动开放。</text>
    </view>
    <scroll-view class="date-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="date-list">
        <button
          wx:for="{{dates}}"
          wx:key="key"
          class="date-option {{selectedDateKey === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          aria-label="{{item.dateLabel}}，{{item.weekday}}{{selectedDateKey === item.key ? '，已选择' : ''}}"
          aria-checked="{{selectedDateKey === item.key}}"
          aria-disabled="{{interactionLocked}}"
          bindtap="selectDate"
        >
          <text class="date-relative">{{item.relativeLabel || item.weekday}}</text>
          <text class="date-value">{{item.dateLabel}}</text>
          <text class="date-weekday">{{selectedDateKey === item.key ? '已选' : item.relativeLabel ? item.weekday : '可选择'}}</text>
        </button>
      </view>
    </scroll-view>

    <view class="time-grid">
      <button
        wx:for="{{timeOptions}}"
        wx:key="serviceStartAt"
        class="time-option {{selectedServiceStartAt === item.serviceStartAt ? 'is-active' : ''}} {{!item.available ? 'is-disabled' : ''}}"
        disabled="{{!item.available}}"
        data-start="{{item.serviceStartAt}}"
        aria-label="{{item.label}}，{{selectedServiceStartAt === item.serviceStartAt ? '已选择' : item.note}}"
        aria-checked="{{selectedServiceStartAt === item.serviceStartAt}}"
        aria-disabled="{{!item.available || interactionLocked}}"
        bindtap="selectTime"
      >
        <text class="time-value">{{item.label}}</text>
        <text class="time-note">{{selectedServiceStartAt === item.serviceStartAt ? '已选 · ' + item.note : item.note}}</text>
      </button>
    </view>

    <view
      wx:if="{{availabilityFailed && !summaryExpanded}}"
      class="availability-error"
      aria-live="polite"
    >
      <text>{{bookingMessage}}</text>
      <text>请点击底部“重新查询可约时间”继续。</text>
    </view>

    <view class="section-heading">
      <view>
        <text class="section-title">选择服务人员</text>
        <text class="section-note">请选择为你服务的美容师</text>
      </view>
      <text class="section-step">人员</text>
    </view>
    <scroll-view class="therapist-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="therapist-list">
        <button
          wx:for="{{therapists}}"
          wx:key="id"
          class="therapist-card {{selectedTherapist.id === item.id ? 'is-selected' : ''}}"
          data-id="{{item.id}}"
          aria-label="{{item.name}}，{{item.specialty}}{{selectedTherapist.id === item.id ? '，已选择' : ''}}"
          aria-checked="{{selectedTherapist.id === item.id}}"
          aria-disabled="{{interactionLocked}}"
          bindtap="selectTherapist"
        >
          <view class="therapist-avatar tone-{{item.tone}}">{{item.mark}}</view>
          <text class="therapist-name">{{item.name}}</text>
          <text class="therapist-specialty">{{item.specialty}}</text>
          <text wx:if="{{selectedTherapist.id === item.id}}" class="therapist-selected">已选</text>
        </button>
      </view>
    </scroll-view>

    <view class="booking-note">
      <text class="booking-note-title">预约说明</text>
      <text>提交后需等待门店确认，页面会显示确认截止时间；确认前不会产生支付。</text>
    </view>
  </view>

  <view class="booking-bar {{summaryExpanded ? 'is-expanded' : ''}}">
    <view wx:if="{{summaryExpanded}}" class="expanded-summary" aria-label="预约摘要">
      <view class="expanded-summary-head">
        <text class="expanded-summary-title">预约摘要</text>
        <button wx:if="{{!interactionLocked}}" class="summary-close" aria-label="收起预约摘要" bindtap="hideBookingSummary">收起</button>
      </view>
      <text class="expanded-summary-line">{{storeName}}｜{{guestCount}} 位｜{{selectedService.name}} {{selectedService.durationMinutes}} 分钟</text>
      <text class="expanded-summary-line">{{selectedDateLabel}} {{selectedTime}}｜{{selectedTherapist.name}}｜预计 {{totalLabel}}</text>
      <view
        wx:if="{{bookingMessage}}"
        class="booking-status is-{{bookingTone}}"
        aria-live="polite"
      >
        <text>{{bookingMessage}}</text>
        <text wx:if="{{confirmationDeadline}}" class="confirmation-deadline">门店确认截止 {{confirmationDeadline}}</text>
      </view>
    </view>

    <view class="booking-bar-main">
      <view class="booking-summary">
        <text class="summary-caption">{{selectedService.name}} · {{selectedTime}}</text>
        <text class="summary-price">{{selectedDateLabel}} · 预计 {{totalLabel}}</text>
      </view>
      <button
        class="continue-button {{primaryActionDisabled ? 'is-disabled' : ''}}"
        loading="{{submitting}}"
        aria-disabled="{{primaryActionDisabled}}"
        aria-label="{{primaryActionLabel}}"
        aria-expanded="{{summaryExpanded}}"
        bindtap="handlePrimaryAction"
      >
        {{primaryActionLabel}}
      </button>
    </view>
  </view>
</view>
